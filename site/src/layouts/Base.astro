---
import '../styles.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'velo: a fast, keyboard-first notes app for macOS, Windows and Linux.' } = Astro.props;
// BASE_URL has no trailing slash in this Astro version; normalize so links to subpages don't
// glue the base and the path together (e.g. "/veloguide/").
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// One place to add or reorder pages.
const nav = [
  { label: 'Home', path: '/' },
  { label: 'Guide', path: '/guide/' },
  { label: 'Shortcuts', path: '/shortcuts/' },
  { label: 'Agents', path: '/agents/' },
  { label: 'Recipes', path: '/recipes/' },
  { label: 'Demo', path: '/demo/' },
  { label: 'Changelog', path: '/changelog/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav aria-label="Main">
        {nav.map((n) => {
          const href = `${base}${n.path}`;
          return <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{n.label}</a>;
        })}
        <a href="https://github.com/cef62/velo">GitHub</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <a href="https://github.com/cef62/velo">velo</a> · MIT · inspired by nvALT, not affiliated with its authors
      </p>
    </footer>
  </body>
</html>

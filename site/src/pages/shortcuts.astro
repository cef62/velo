---
import Base from '../layouts/Base.astro';
import rows from '../content/reference/shortcuts.json';

const groups = [...new Set(rows.map((r) => r.group))].map((name) => ({ name, rows: rows.filter((r) => r.group === name) }));
---

<Base title="Shortcuts · velo">
  <article class="prose">
    <h1>Shortcuts</h1>
    <p>
      Every shortcut can be changed in Settings › Keyboard shortcuts. Actions marked <strong>global</strong> work
      from any app, even when velo is in the background. Actions with no default key can be bound in the same place.
    </p>
    {groups.map((g) => (
      <>
        <h2 id={g.name.toLowerCase().replace(/[^a-z]+/g, '-')}>{g.name}</h2>
        <table>
          <thead><tr><th>Action</th><th>macOS</th><th>Windows / Linux</th></tr></thead>
          <tbody>
            {g.rows.map((r) => (
              <tr>
                <td>{r.label.replace(' (global)', '')}{r.global && <> <strong>(global)</strong></>}</td>
                {r.mac === null
                  ? <td colspan="2" class="unbound">— (no default, bind in Settings)</td>
                  : <><td><kbd>{r.mac}</kbd></td><td><kbd>{r.other}</kbd></td></>}
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ))}
    <p><small>Generated from the app's defaults (<code>src/shortcuts.ts</code>). Your own bindings are not shown here.</small></p>
  </article>
</Base>

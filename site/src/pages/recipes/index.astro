---
import { recipes } from '../../content/recipes/recipes.ts';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = [
  { title: 'Keyboard', intro: 'Step by step, with the default shortcuts (all remappable in Settings).', items: recipes.filter((r) => r.kind === 'keys') },
  { title: 'Agents', intro: 'Ask Claude Code to work on your notes through velo’s MCP server.', items: recipes.filter((r) => r.kind === 'agent') },
];
---

<Base title="Recipes · velo" description="Short, step-by-step recipes for velo: capture, search, tasks, timeline, encryption, Related, the command palette and agents.">
  <article class="prose">
    <h1>Recipes</h1>
    <p class="lede">Short walkthroughs of things velo is good at.</p>
    {
      groups.map((g) => (
        <section>
          <h2>{g.title}</h2>
          <p>{g.intro}</p>
          <ul class="recipe-list">
            {g.items.map((r) => (
              <li>
                <a href={`${base}/recipes/${r.slug}/`}>{r.title}</a>
                <span set:html={r.summary} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</Base>

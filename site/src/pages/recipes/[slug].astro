---
import Clip from '../../components/Clip.astro';
import Shot from '../../components/Shot.astro';
import Transcript from '../../components/Transcript.astro';
import { recipes, type Recipe } from '../../content/recipes/recipes.ts';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return recipes.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}

const { recipe } = Astro.props as { recipe: Recipe };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const i = recipes.indexOf(recipe);
const [prev, next] = [recipes[i - 1], recipes[i + 1]];
---

<Base title={`${recipe.title} · velo recipes`} description={recipe.goal}>
  <article class="prose recipe">
    <p class="recipe-crumb"><a href={`${base}/recipes/`}>Recipes</a> · {recipe.kind === 'keys' ? 'Keyboard' : 'Agents'}</p>
    <h1>{recipe.title}</h1>
    <p class="lede">{recipe.goal}</p>

    <h2>Before you start</h2>
    <ul>{recipe.prerequisites.map((p) => <li set:html={p} />)}</ul>

    <h2>Steps</h2>
    {
      recipe.kind === 'keys' ? (
        <Transcript mode="keys" steps={recipe.steps} />
      ) : (
        <Transcript mode="agent" transcript={recipe.transcript} prompt={recipe.prompt} answer={recipe.answer} />
      )
    }
    {recipe.kind === 'agent' && <p class="recipe-note">A real run: the tool calls and results come from velo’s own tools on a sample vault, checked by its test suite. Dates are shown in UTC and hashes are replaced by stable placeholders.</p>}

    <Shot name={recipe.shot} alt={recipe.title} />
    {recipe.clip && <Clip name={recipe.clip} alt={`${recipe.title}: a recorded run in the demo`} />}

    <h2>Why it works</h2>
    <p set:html={recipe.why} />

    <nav class="recipe-pager" aria-label="More recipes">
      {prev ? <a href={`${base}/recipes/${prev.slug}/`}>← {prev.title}</a> : <span />}
      {next && <a href={`${base}/recipes/${next.slug}/`}>{next.title} →</a>}
    </nav>
  </article>
</Base>

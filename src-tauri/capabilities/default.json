{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-destroy", "core:menu:default", "dialog:default", "opener:allow-reveal-item-in-dir", "global-shortcut:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }] }
  ]
}
